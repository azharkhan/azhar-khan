---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { dayMonth, yearOf } from "../lib/dates";
import { metricView } from "../lib/home/ledger";
import type { GardenEntry, Metric } from "../lib/garden/schema";
import { cardContext, cardVariant, coverAspect, excerpt } from "../lib/garden/wall";

interface Props {
  entry: GardenEntry;
  path: string;
  metric?: Metric;
  pursuitLabel: string;
  buildYear: number;
}

const { entry, path, metric, pursuitLabel, buildYear } = Astro.props;
const variant = cardVariant(entry);
const context = cardContext(entry, buildYear, metric);
const view = !context && metric ? metricView(metric) : undefined;
const when = `${dayMonth(entry.lastTouched)} ${yearOf(entry.lastTouched)}`;
const description = excerpt(entry);

---

<article class:list={["card", `card-${variant}`]} data-variant={variant}>
  {variant === "still" && entry.photo && (
    <figure class="photo-print">
      <Image src={entry.photo.src as ImageMetadata} alt={entry.photo.alt} format="webp" widths={[320, 640]} sizes="(min-width: 60rem) 16rem, (min-width: 40rem) 30vw, 80vw" />
      {entry.photo.caption && <figcaption>{entry.photo.caption}</figcaption>}
    </figure>
  )}
  {variant === "cover" && entry.cover && (
    typeof entry.cover === "string" ? (
      <img class="cover" src={entry.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" style={`aspect-ratio: ${coverAspect(entry)}`} />
    ) : (
      <Image class="cover" src={entry.cover} alt="" format="webp" widths={[320, 640]} sizes="(min-width: 60rem) 16rem, (min-width: 40rem) 30vw, 80vw" />
    )
  )}
  <p class="mono card-meta">{pursuitLabel} · <time datetime={entry.lastTouched.toISOString()}>{when}</time></p>
  <h2 class="card-title"><a href={path}>{entry.title}</a></h2>
  {context && <p class="card-context">{context}</p>}
  {view && (
    <p class="card-metric">
      {view.kind === "stars" ? <span class="stars" role="img" aria-label={view.label}>{view.text}</span> : view.text}
      {view.kind === "stat" && view.change && <span class="card-change">{view.change}</span>}
    </p>
  )}
  {description && <p class="card-excerpt">{description}</p>}
</article>
